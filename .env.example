# ---- Skal udfyldes -------------------------------------------------------

# Nøgle fra FACEIT Developer Portal → App Studio. Commit den aldrig.
FACEIT_API_KEY=

# Twitch-kontoen botten skriver fra. Tokenet må gerne have "oauth:" foran.
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=

# Alle kanaler botten hører til, adskilt af komma. Det er HELE listen: en
# kanal der fjernes her forlades ved næste genstart, og en der sættes
# tilbage kommer igen med sin spillerliste i behold.
TWITCH_CHANNELS=

# Twitch-logins der styrer botten, adskilt af komma. De må køre alle
# kommandoer i alle kanaler uden at være moderator — også !csbotleave.
BOT_OWNERS=

# ---- Token-fornyelse (anbefalet) -----------------------------------------
# Uden dette stopper botten om ~60 dage med "Login authentication failed".
# Refresh token følger med access token fra token-generatoren; et client
# secret fra https://dev.twitch.tv/console/apps fornyer hos Twitch selv.

TWITCH_REFRESH_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- Alt herunder har en default ----------------------------------------
# Værdierne er dem koden bruger i forvejen. Fjern havelågen for at ændre.

# Region og land for kanaler der ikke har sat deres eget med !csbotregion
# og !csbotcountry. Hver kanal husker sit eget, så blandet er fint.
# FACEIT_REGION=EU
# FACEIT_COUNTRY=DK

# "letters" giver "L10 2347elo". "emotes" bytter niveauet ud med 7TV-emotes
# ved navn LVL1 … LVL10 — 7TV skelner mellem store og små bogstaver.
# RANK_STYLE=emotes
# RANK_EMOTE_PREFIX=LVL

# Præfiks på opsætningskommandoerne: !csbotaddplayer og resten.
# ADMIN_PREFIX=csbot

# TIMEZONE=Europe/Copenhagen
# WIKI_URL=https://github.com/Petsen02/CS-Bot

# Sås ind i den FØRSTE kanal ved allerførste start. Sjældent nødvendigt:
# enhver der bliver slået op havner selv på watch-listen.
# PLAYERS=
# DEFAULT_PLAYER=

# Placering vises kun for top 1000 i regionen. !top opdaterer på faste
# klokkeslæt, så alle i chatten ser samme tal — 1440 = ved lokal midnat.
# RANKING_POSITION_LIMIT=1000
# RANKING_REFRESH_MINUTES=1440

# Spillere der spiller pollers ofte; inaktive trapper hårdt ned.
# ACTIVE_POLL_SECONDS=60
# IDLE_POLL_SECONDS=600
# ACTIVE_WINDOW_MINUTES=60
# RANK_CACHE_SECONDS=60
# COMMAND_COOLDOWN_SECONDS=5

# FACEIT's dokumenterede budget er ikke bekræftet, så disse er bevidst lave.
# FACEIT_LIMIT_PER_SECOND=5
# FACEIT_LIMIT_PER_TEN_MINUTES=400

# ESEA-ligaens id. Sæsonen udledes automatisk, så en ny sæson kræver intet.
# ESEA_LEAGUE_ID=a14b8616-45b9-4581-8637-4dfd0b5f6af8
