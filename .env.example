# ---- FACEIT --------------------------------------------------------------
# Key from the FACEIT Developer Portal, App Studio (never commit this)
FACEIT_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Region and country used by channels that have not set their own with
# !oldregion / !oldcountry. Each channel keeps its own, so mixed is fine.
FACEIT_REGION=EU
FACEIT_COUNTRY=DK

# Request budget. FACEIT's documented allowance has NOT been confirmed yet,
# so these are deliberately conservative — raise them once it is known.
FACEIT_LIMIT_PER_SECOND=5
FACEIT_LIMIT_PER_TEN_MINUTES=400

# ---- ESEA ----------------------------------------------------------------
# ESEA League's id på FACEIT, som det står i den offentlige liga-URL:
# faceit.com/en/cs2/league/esea%20league/<dette id>/...
# Sæsonen udledes automatisk af ligaen, så en ny sæson kræver ingen ændring.
ESEA_LEAGUE_ID=a14b8616-45b9-4581-8637-4dfd0b5f6af8

# ---- Twitch --------------------------------------------------------------
TWITCH_BOT_USERNAME=yourbotaccount
# With or without the "oauth:" prefix
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Channels to join, comma separated. Rosters are managed in chat, not here.
TWITCH_CHANNELS=yourchannel

# ---- Token-fornyelse (valgfri, men anbefalet) -----------------------------
# Et Twitch-token udløber efter omkring 60 dage. Uden en refresh token stopper
# botten en tilfældig dag med "Login authentication failed".
#
# Refresh token får du sammen med access token fra token-generatoren.
TWITCH_REFRESH_TOKEN=

# Med et client secret fornyes tokenet hos Twitch selv, uden om tredjepart.
# Opret en app på https://dev.twitch.tv/console/apps — OAuth Redirect URL kan
# være http://localhost, kategorien er ligegyldig. Uden secret fornyes der
# gennem twitchtokengenerator.com, hvilket virker, men binder botten til at
# den side bliver ved med at findes.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- First-run seed ------------------------------------------------------
# Copied into the FIRST channel the very first time the bot starts, and
# ignored once that channel has a roster. Nicknames or SteamID64s.
PLAYERS=
DEFAULT_PLAYER=

# ---- Appearance ----------------------------------------------------------
# How levels are written in chat. Defaults to emotes.
#   letters = "L10 2347elo"
#   emotes  = "LVL10 2347 elo", swapped for 7TV channel emotes named
#             LVL1 ... LVL10. 7TV is case sensitive. Viewers without the
#             extension see the level name as plain text, which still reads.
RANK_STYLE=emotes

# The emote names in the channel's 7TV set. Change this if the set uses
# another prefix — "LEVEL" would give LEVEL1 ... LEVEL10.
RANK_EMOTE_PREFIX=LVL

# Show a ranking position only for players this high or better. FACEIT gives
# Challenger status to the top 1000 of each region.
RANKING_POSITION_LIMIT=1000

# ---- Timing --------------------------------------------------------------
# Where !oldcommands sends people.
WIKI_URL=https://github.com/Petsen02/CS-Bot

TIMEZONE=Europe/Copenhagen

# !top refreshes on fixed clock boundaries, not a rolling timer, so everyone
# in chat sees the same figure. 1440 = once a day at local midnight.
RANKING_REFRESH_MINUTES=1440

# Accounts that are playing are polled often; idle ones back off hard. A
# FACEIT match runs longer than a League game, hence the wider active window.
ACTIVE_POLL_SECONDS=60
IDLE_POLL_SECONDS=600
ACTIVE_WINDOW_MINUTES=60

RANK_CACHE_SECONDS=60
COMMAND_COOLDOWN_SECONDS=5
